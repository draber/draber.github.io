        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^1.0.2",
        "chalk": "^6.0.1",
        "chokidar": "^5.0.0",
        "cssnano": "^9.9.0",
        "jsdom": "^31.0.1",
        "minimist": "^1.2.8",
        "postcss": "^8.5.33",
        "postcss-import": "^17.0.1",
        "postcss-nesting": "^14.0.3",
        "rollup": "^4.40.0",
        "rollup-plugin-cleanup": "^3.2.1",
