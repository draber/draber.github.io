    "description": "Spelling Bee Assistant is an add-on for Spelling Bee, the New York Times’ popular word puzzle",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "node ./src/builder/runner.js",
        "build": "node ./src/builder/runner.js -p",
